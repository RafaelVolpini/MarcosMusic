# Copie para .env e preencha com valores reais. Nunca commite o .env preenchido.

# ── Postgres (perfil prod — Railway) ──────────────────────────────────
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# ── Perfil ativo ───────────────────────────────────────────────────────
# dev (padrao local) ou prod (definido pelo Railway)
SPRING_PROFILES_ACTIVE=

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Storage (upload de videoaulas) ───────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# ── SMTP (reset de senha) ─────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend / CORS ───────────────────────────────────────────────────
APP_FRONTEND_URL=
APP_CORS_ALLOWED_ORIGINS=
